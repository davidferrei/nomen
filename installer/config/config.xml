<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <!-- Application Info -->
    <Name>Nomen</Name>
    <Version>1.0.0</Version>
    <Title>Nomen - Installer</Title>
    <Publisher>Nomen</Publisher>
    
    <!-- Installation Paths -->
    <!-- Linux Home: ~/Nomen -->
    <TargetDir>@HomeDir@/Nomen</TargetDir>
    
    <!-- Windows -->
    <StartMenuDir>Nomen</StartMenuDir>
    
    <!-- UI Customization -->
    <!-- <AllowNonAsciiCharacters>false</AllowNonAsciiCharacters> -->
    <Logo>app_icon_logo.png</Logo>
    <InstallerWindowIcon>app_icon_window.png</InstallerWindowIcon>
    <TitleColor>#25DDB2</TitleColor>

    <ProductImages>
        <ProductImage>
            <Image>app_icon_product.png</Image>
            <Url>https://github.com/davidferrei/nomen</Url>
        </ProductImage>
    </ProductImages>
    
    <!-- Post-Install Action -->
    <!-- <RunProgramDescription>Launch Nomen</RunProgramDescription>
    <RunProgram>@TargetDir@/bin/Nomen</RunProgram> -->
</Installer>